{
  "name": "jev-voice-pokemon",
  "version": "1.0.0",
  "description": "Voice, text, controls or AI agents play Pokémon Red, with Jev working out which on-screen action a command means. Fork of christianmat/jev-pokemon. Bring your own ROM.",
  "scripts": {
    "gen": "tsx scripts/gen-data.ts",
    "setup": "bash scripts/setup.sh",
    "start": "vite build web && tsx src/server/main.ts",
