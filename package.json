    "@modelcontextprotocol/sdk": "^1.32.2",
    "ai": "^7.0.171",
    "serverboy": "^0.0.7",
    "ws": "^8.21.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
