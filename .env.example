# Jev works out which on-screen action a command means.
#   gateway (default): the real Jev, called at TypeSafe's API with the key below
#   mock: a free local word-matcher, no key needed
# With no key set, the local word-matcher is used whatever the mode.
JEV_MODE=gateway
TYPESAFE_API_KEY=
# jev-latest, jev-preview, or a pinned release such as jev-1.14.0
JEV_MODEL=jev-latest
JEV_MIN_INTERVAL_MS=0
JEV_MAX_PER_MIN=90

ROM_PATH=roms/red.gb
PORT=8787

# Answering questions ("what is Onix weak to?") uses Claude. Without a key everything else still works.
ANTHROPIC_API_KEY=
ANSWER_MODEL=claude-sonnet-5-5
# Answers are read aloud. With a Cartesia key (https://play.cartesia.ai/keys), Cartesia speaks them
# (the answer text is sent to Cartesia). Without one: the Mac's own voice, or else the browser's voice.
CARTESIA_API_KEY=
# A Cartesia voice id (default: Quentin, a measured narrator) and model.
CARTESIA_VOICE=
CARTESIA_MODEL=sonic-3.6
# The Mac voice used when there is no Cartesia key (any installed `say` voice).
SPEAK_VOICE=Daniel

# When to act on a command without asking (probabilities from Jev). Costly = hard-to-undo actions.
ACT_MIN_P=0.6
ACT_MIN_MARGIN=0.2
COSTLY_MIN_P=0.85
COSTLY_MIN_MARGIN=0.4
JEV_TIMEOUT_MS=4000

# Send Jev a picture of the game screen with each command (1) or only the game's facts (0).
# In trials Jev could not recognise things in Game Boy graphics, so this adds little today.
JEV_SEES_SCREEN=1
