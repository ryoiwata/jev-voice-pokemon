# Jev backend: "mock" (default: a free local word-matcher, no key) or "gateway" (real Jev via Vercel AI Gateway)
JEV_MODE=mock
# Needed for JEV_MODE=gateway
AI_GATEWAY_API_KEY=
JEV_MODEL=typesafe-ai/jev
JEV_MIN_INTERVAL_MS=0
JEV_MAX_PER_MIN=90

ROM_PATH=roms/red.gb
PORT=8787

# Answering questions ("what is Onix weak to?") uses Claude. Without a key everything else still works.
ANTHROPIC_API_KEY=
ANSWER_MODEL=claude-sonnet-5-5

# When to act on a command without asking (probabilities from Jev). Costly = hard-to-undo actions.
ACT_MIN_P=0.6
ACT_MIN_MARGIN=0.2
COSTLY_MIN_P=0.85
COSTLY_MIN_MARGIN=0.4
JEV_TIMEOUT_MS=4000
